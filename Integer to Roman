class Solution {
    public String intToRoman(int num) {
        
        // Step 1: Store values and their corresponding Roman symbols
        int[] values = {
            1000, 900, 500, 400,
            100, 90, 50, 40,
            10, 9, 5, 4, 1
        };

        String[] symbols = {
            "M", "CM", "D", "CD",
            "C", "XC", "L", "XL",
            "X", "IX", "V", "IV", "I"
        };

        // Step 2: StringBuilder for efficient string concatenation
        StringBuilder result = new StringBuilder();

        // Step 3: Loop through all values
        for (int i = 0; i < values.length; i++) {
            
            // Step 4: Keep subtracting while num >= current value
            while (num >= values[i]) {
                num -= values[i];               // subtract value
                result.append(symbols[i]);      // add symbol
            }
        }

        // Step 5: Return final Roman string
        return result.toString();
    }
}

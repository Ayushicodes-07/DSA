class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {
        int n = nums.length;
        int []res = new int [n-k+1];
        for(int i = 0; i <= n-k; i++){
            int cM = nums[i];
           for (int j = 1; j < k; j++) {
                if (nums[i + j] > cM) {
                    cM = nums[i + j];
                }
            }res[i] = cM;
    }return res;
}}
